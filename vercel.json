{
  "redirects": [
    {
      "source": "/onboarding/:path*",
      "destination": "/app/onboarding/:path*",
      "permanent": false
    },
    {
      "source": "/vow-path/:path*",
      "destination": "/app/vow-path/:path*",
      "permanent": false
    },
    {
      "source": "/vow-path",
      "destination": "/app/vow-path",
      "permanent": false
    },
    {
      "source": "/library/:path*",
      "destination": "/app/library/:path*",
      "permanent": false
    },
    {
      "source": "/library",
      "destination": "/app/library",
      "permanent": false
    },
    {
      "source": "/motivation/:path*",
      "destination": "/app/motivation/:path*",
      "permanent": false
    },
    {
      "source": "/motivation",
      "destination": "/app/motivation",
      "permanent": false
    },
    {
      "source": "/slip/:rest*",
      "destination": "/app/slip/:rest*",
      "permanent": false
    },
    {
      "source": "/urge/:rest*",
      "destination": "/app/urge/:rest*",
      "permanent": false
    },
    {
      "source": "/milestones/:rest*",
      "destination": "/app/milestones/:rest*",
      "permanent": false
    },
    {
      "source": "/welcome",
      "destination": "/app/welcome",
      "permanent": false
    },
    {
      "source": "/signup",
      "destination": "/app/signup",
      "permanent": false
    },
    {
      "source": "/home",
      "destination": "/app/home",
      "permanent": false
    },
    {
      "source": "/profile",
      "destination": "/app/profile",
      "permanent": false
    },
    {
      "source": "/slips",
      "destination": "/app/slips",
      "permanent": false
    },
    {
      "source": "/urges",
      "destination": "/app/urges",
      "permanent": false
    },
    {
      "source": "/anchors",
      "destination": "/app/anchors",
      "permanent": false
    },
    {
      "source": "/mirror",
      "destination": "/app/mirror",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|sitemap|robots).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://checkout.razorpay.com https://cdn.razorpay.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.razorpay.com https://lumberjack.razorpay.com https://cdn.razorpay.com https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com; frame-src 'self' https://*.razorpay.com https://api.razorpay.com; media-src 'self' https://*.supabase.co; img-src 'self' data: https:; font-src 'self' data:;"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
