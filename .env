# ============================================================
# Vow — LOCAL build environment (native / Android build only)
# ------------------------------------------------------------
# This file is gitignored by the "*.local" rule in .gitignore,
# so it stays on your machine and is never committed. Keep the
# name exactly ".env.local" — do NOT rename it to ".env" (that
# one is not ignored and could get pushed with your key in it).
#
# Your WEB build gets its keys from Cloudflare and ignores this
# file. This file exists only so your local `npm run build`
# (the one before `npx cap sync android`) can bake in the
# values below for the Android app.
# ============================================================

# RevenueCat PUBLIC Android SDK key.
# RevenueCat dashboard -> Project Settings -> API keys ->
# the key for your Google Play / Android app (it starts with "goog_").
# Replace the placeholder below with your real key.
VITE_REVENUECAT_ANDROID_KEY=goog_kZNQshIdcNmgqfbRVdkdQxiCRgS

# Native launch flags (see src/config/featureFlags.js).
# CADENCE_LOCKED=true  -> enforces the daily one-day-per-24h pacing.
# PAYWALL_ENABLED=true -> matches the documented native config
#                         (the real gate is StageEntitlementGate).
VITE_CADENCE_LOCKED=true
VITE_PAYWALL_ENABLED=true
